# Copy to .env (gitignored). Do not use .env.local.
# AUTH_TOKEN — login password:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN=
# ENCRYPTION_KEY — 16-byte hex. Do not rotate after saving connections:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=
# Optional — GIA / log Analyze. Create at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
